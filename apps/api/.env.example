# Server Configuration
PORT=3002
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_PATH=./db/properties.db

# Production Database Configuration (Turso)
# Set to 'true' to use Turso database in production
USE_TURSO=false
# Turso database URL (get this from your Turso dashboard)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# Turso auth token (get this from your Turso dashboard)
TURSO_AUTH_TOKEN=your-auth-token-here
# Optional: Sync URL for embedded replicas (leave empty for remote-only)
TURSO_SYNC_URL=
# Optional: Local database file for embedded replica mode
TURSO_LOCAL_DB_PATH=./db/turso-replica.db

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-256-bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_ROUNDS=12

# Scraper Configuration
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
SCRAPER_DELAY_MS=1000
SCRAPER_MAX_CONCURRENT=2

# Logging
LOG_LEVEL=info
LOG_FILE=scraper.log
