{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "next.config.js",
    ".next/types/**/*.ts"
  ],
  "paths": {
    "@/*": ["./**/*"],
    "@components/*": ["./components/*"],
    "@lib/*": ["./lib/*"]
  },
  "exclude": [
    "node_modules"
  ]
}
